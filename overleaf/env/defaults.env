OVERLEAF_VERSION=latest
OVERLEAF_APP_ROOT=/opt/persistent-storage/overleaf/app
OVERLEAF_HTTP_PORT=8080
SERVER_PRO=false
OVERLEAF_SITE_URL=http://localhost:8080
OVERLEAF_MONGO_URL: mongodb://mongo/sharelatex
OVERLEAF_NAV_TITLE=Overleaf Community Ed.
OVERLEAF_REDIS_HOST=redis
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file
ENABLE_CONVERSIONS=true
ENABLE_CRON_RESOURCE_DELETION=true
EMAIL_CONFIRMATION_DISABLED=true
OVERLEAF_INVITE_TOKEN_SECRET=
MONGO_VERSION=8.3
MONGO_APP_ROOT=/opt/persistent-storage/overleaf/mongo
MONGO_INITDB_DATABASE=sharelatex
REDIS_VERSION=7.4
REDIS_APP_ROOT=/opt/persistent-storage/overleaf/redis
REDIS_HOST=redis
REDIS_AOF_PERSISTENCE=true
NGINX_ENABLED=false
USER_UID=1000
USER_GID=1000

## fix for mongo >=8
GLIBC_TUNABLES=glibc.pthread.rseq=1
